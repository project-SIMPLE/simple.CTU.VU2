    - target: {fileID: 8881028038475493880, guid: fd28f23af44f73f4a95e33435872ad15,
        type: 3}
      propertyPath: m_Text
      value: "C\xE2y c\u1EE7 d\u1EC1n (t\xEAn khoa h\u1ECDc: Beta vulgaris) l\xE0
        m\u1ED9t lo\u1EA1i c\xE2y thu\u1ED9c h\u1ECD Rau mu\u1ED1i (Amaranthaceae),
        \u0111\u01B0\u1EE3c tr\u1ED3ng ph\u1ED5 bi\u1EBFn tr\xEAn th\u1EBF gi\u1EDBi
